# 复制为 deploy/.env 后填入真实值；该文件不应提交到 git（.gitignore 已排除）。
#
# 与仓库根目录的 .env.example（本地开发用）的关键差异：
# - DATABASE_URL 的 host 是 `postgres`（docker-compose 服务名），不是 127.0.0.1
# - NODE_ENV=production（持续部署运行的环境按惯例用 production 获得框架层面的优化）
# - APP_ENV=test（这才是真正代表"这是测试环境、不是正式生产环境"的变量；
#   AUTH_SMS_TEST_MODE 等安全检查看的是 APP_ENV。等这台服务器真正变成正式生产环境
#   时，再把 APP_ENV 改成 production，并把 AUTH_SMS_TEST_MODE 改成 false）

NODE_ENV=production
APP_ENV=test
PORT=3000

# --- PostgreSQL（docker-compose 里的 postgres 服务）---
POSTGRES_DB=home_exchange
POSTGRES_USER=home_exchange
POSTGRES_PASSWORD=change-me-to-a-strong-password
DATABASE_URL="postgresql://home_exchange:change-me-to-a-strong-password@postgres:5432/home_exchange"

# --- JWT ---
# 必须换成与本地开发不同的强随机值，不要复用 .env.example 里的示例值
JWT_SECRET=change-me-to-a-long-random-production-secret
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d

# --- 日志 ---
LOG_LEVEL=info

# --- 微信小程序（customer-phone-auth）---
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=

# --- 敏感个人信息加密（customer-profile：身份证号等）---
# 32 字节随机密钥，base64 编码；生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 必须与本地开发用的不同；一旦投入使用后不要随意更换（已加密的数据会变得无法解密）
PII_ENCRYPTION_KEY=

# --- 短信验证码（customer-phone-auth）---
# 腾讯云短信资质还在单独推进中，测试环境先继续用固定验证码 999999。
# 等真实短信调通之后，把这里改成 false 并填入真实凭证即可，不需要改代码。
AUTH_SMS_TEST_MODE=true
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=

# 小程序提交实名走真实腾讯云。这台测试机填 home-exchange-server-test 的密钥。
# 正式机填 home-exchange-cos-prod 的密钥。FACEID_TEST_MODE 保持 false。
FACEID_TEST_MODE=false
TENCENT_FACEID_SECRET_ID=
TENCENT_FACEID_SECRET_KEY=

# --- 腾讯云对象存储（测试环境私有桶）---
# 使用 home-exchange-server-test 子用户的密钥，不要用主账号密钥。
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=
COS_CDN_BASE_URL=https://imgtest.wandercat.cn
