# 复制为 .env 后按需修改；.env 本身不会被提交到 Git。

NODE_ENV=development
# APP_ENV 未设置时默认等于 NODE_ENV。只有当某个"持续部署运行的环境"需要把 NODE_ENV 设为
# production（获得框架优化）但它又不是真正的生产环境时（例如测试环境），才需要显式设置
# APP_ENV 加以区分——安全类检查（如 AUTH_SMS_TEST_MODE）认的是 APP_ENV，不是 NODE_ENV。
# 本地开发不需要管这个变量。
# APP_ENV=development
PORT=3000

# 本地开发：若使用本机已安装的 PostgreSQL，确保已创建下方账号/数据库（见 README「本地开发」）；
# 若使用 docker-compose（见 docker-compose.yml），账号密码需与其中 postgres 服务保持一致。
DATABASE_URL="postgresql://home_exchange:home_exchange@127.0.0.1:5432/home_exchange"

# JWT
JWT_SECRET=change-me-in-each-environment
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d

# 微信小程序（手机号登录 - 微信一键获取手机号）
# AppSecret 严禁提交到 git、严禁出现在小程序前端代码中，只允许存在于服务端环境变量/密钥管理中
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=

# 敏感个人信息加密（customer-profile：身份证号等）
# 32 字节随机密钥，base64 编码；生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 每个环境必须使用不同的值；一旦投入使用后不要随意更换（已加密的数据会变得无法解密）
PII_ENCRYPTION_KEY=

# 腾讯云对象存储。一个环境一个私有桶。密钥不要提交到 git，也不要写进小程序。
# 留空时证件照片仍写在本地目录。
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_BUCKET=
COS_CDN_BASE_URL=

# 未配置对象存储时，身份证照片密文目录。不要把这个目录暴露成静态资源。
# ID_CARD_PHOTO_DIR=

# 短信验证码（腾讯云国际短信）
# AUTH_SMS_TEST_MODE=true 时：验证码固定为 999999，不发送真实短信（仅允许在非生产环境开启，
# 生产环境下若为 true 会在启动时被拒绝，见 design.md「add-customer-phone-login」Decisions 第 6 条）
AUTH_SMS_TEST_MODE=true
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=

# 日志
LOG_LEVEL=info
