# 复制为 .env 后按需修改；.env 本身不会被提交到 Git。

NODE_ENV=development
PORT=3000

# 本地开发：若使用本机已安装的 MySQL，确保已创建下方账号/数据库（见 README「本地开发」）；
# 若使用 docker-compose（见 docker-compose.yml），账号密码需与其中 mysql 服务保持一致。
DATABASE_URL="mysql://home_exchange:home_exchange@127.0.0.1:3306/home_exchange"

# JWT
JWT_SECRET=change-me-in-each-environment
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d

# 日志
LOG_LEVEL=info
